# ==============================================================================
# 🚀 SpeakUp Project - Environment Variables Configuration (.env)
# ==============================================================================

# --- MÔI TRƯỜNG CHUNG ---
COMPOSE_PROJECT_NAME=speakup
NODE_ENV=development

# --- 1. POSTGRESQL DATABASE ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=speakup_user
POSTGRES_PASSWORD=speakup_secret_pass
POSTGRES_DB=speakup_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- 2. REDIS IN-MEMORY CACHE ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass

# --- 3. RABBITMQ MESSAGE BROKER ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=speakup_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secret_pass

# --- 4. NESTJS BACKEND API ---
API_PORT=3000
JWT_SECRET=speakup_jwt_super_secret_key_change_in_production_2026

# --- 5. ANGULAR FRONTEND WEB ---
WEB_PORT=4200

# --- 6. NGINX REVERSE PROXY GATEWAY ---
NGINX_PORT=80
